<UserControl x:Class="BusinessOS.POS.Desktop.Reports.ReportsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnLoaded">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Border Style="{StaticResource CardBorderStyle}">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="150"/><ColumnDefinition Width="10"/>
     <ColumnDefinition Width="150"/><ColumnDefinition Width="10"/>
     <ColumnDefinition/><ColumnDefinition Width="10"/>
     <ColumnDefinition/><ColumnDefinition Width="10"/>
     <ColumnDefinition/><ColumnDefinition Width="10"/>
     <ColumnDefinition/><ColumnDefinition Width="10"/>
     <ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
     <TextBlock Text="From" Style="{StaticResource MutedTextStyle}"/>
     <DatePicker SelectedDate="{Binding FromDate}" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="To" Style="{StaticResource MutedTextStyle}"/>
     <DatePicker SelectedDate="{Binding ToDate}" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="4">
     <TextBlock Text="Customer" Style="{StaticResource MutedTextStyle}"/>
     <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Label" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="6">
     <TextBlock Text="Supplier" Style="{StaticResource MutedTextStyle}"/>
     <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Label" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="8">
     <TextBlock Text="Product" Style="{StaticResource MutedTextStyle}"/>
     <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Label" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="10">
     <TextBlock Text="Category" Style="{StaticResource MutedTextStyle}"/>
     <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" Margin="0,3,0,0"/>
    </StackPanel>
    <Button Grid.Column="12" Content="Apply" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
    <Button Grid.Column="14" Content="Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
   </Grid>
  </Border>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/>
    <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/>
    <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="NET SALES" Style="{StaticResource StatLabelStyle}"/>
     <TextBlock Text="{Binding NetSales, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/>
     <TextBlock Text="{Binding SalesCount, StringFormat={}{0} sales}" Style="{StaticResource MutedTextStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="AOV" Style="{StaticResource StatLabelStyle}"/>
     <TextBlock Text="{Binding Aov, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="GROSS PROFIT" Style="{StaticResource StatLabelStyle}"/>
     <TextBlock Text="{Binding GrossProfit, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="NET PROFIT" Style="{StaticResource StatLabelStyle}"/>
     <TextBlock Text="{Binding NetProfit, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="8" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="INVENTORY VALUE" Style="{StaticResource StatLabelStyle}"/>
     <TextBlock Text="{Binding InventoryValue, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="10" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="AR / AP" Style="{StaticResource StatLabelStyle}"/>
     <TextBlock Text="{Binding Receivables, StringFormat=AR {0:N2}}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
     <TextBlock Text="{Binding Payables, StringFormat=AP {0:N2}}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/></StackPanel>
   </Border>
  </Grid>

  <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl>
     <TabItem Header="Sales Trend">
      <DataGrid ItemsSource="{Binding SalesTrend}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Day" Binding="{Binding Day, StringFormat=d}" Width="140"/>
        <DataGridTextColumn Header="Sales" Binding="{Binding SalesCount}" Width="85"/>
        <DataGridTextColumn Header="Net Sales" Binding="{Binding NetSales, StringFormat=N2}" Width="120"/>
        <DataGridTextColumn Header="Gross Profit" Binding="{Binding GrossProfit, StringFormat=N2}" Width="120"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Top Products">
      <DataGrid ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
        <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
        <DataGridTextColumn Header="Qty" Binding="{Binding QuantityBase}" Width="90"/>
        <DataGridTextColumn Header="Net Sales" Binding="{Binding NetSales, StringFormat=N2}" Width="110"/>
        <DataGridTextColumn Header="COGS" Binding="{Binding Cogs, StringFormat=N2}" Width="100"/>
        <DataGridTextColumn Header="Profit" Binding="{Binding GrossProfit, StringFormat=N2}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Slow Products">
      <DataGrid ItemsSource="{Binding SlowProducts}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
        <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
        <DataGridTextColumn Header="Qty" Binding="{Binding QuantityBase}" Width="90"/>
        <DataGridTextColumn Header="Net Sales" Binding="{Binding NetSales, StringFormat=N2}" Width="110"/>
        <DataGridTextColumn Header="COGS" Binding="{Binding Cogs, StringFormat=N2}" Width="100"/>
        <DataGridTextColumn Header="Profit" Binding="{Binding GrossProfit, StringFormat=N2}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Category Profit">
      <DataGrid ItemsSource="{Binding CategoryProfit}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
        <DataGridTextColumn Header="Net Sales" Binding="{Binding NetSales, StringFormat=N2}" Width="140"/>
        <DataGridTextColumn Header="COGS" Binding="{Binding Cogs, StringFormat=N2}" Width="120"/>
        <DataGridTextColumn Header="Gross Profit" Binding="{Binding GrossProfit, StringFormat=N2}" Width="140"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Customers">
      <DataGrid ItemsSource="{Binding CustomerBalances}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Receivable" Binding="{Binding Balance, StringFormat=N2}" Width="150"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Suppliers">
      <DataGrid ItemsSource="{Binding SupplierBalances}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Payable" Binding="{Binding Balance, StringFormat=N2}" Width="150"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Inventory">
      <DataGrid ItemsSource="{Binding Inventory}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
        <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
        <DataGridTextColumn Header="On Hand" Binding="{Binding StockOnHand}" Width="100"/>
        <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumStock}" Width="100"/>
        <DataGridCheckBoxColumn Header="Low" Binding="{Binding LowStock}" Width="70"/>
        <DataGridTextColumn Header="FIFO Value" Binding="{Binding InventoryValue, StringFormat=N2}" Width="120"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Expiry">
      <DataGrid ItemsSource="{Binding Expiring}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
        <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="120"/>
        <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiresAt, StringFormat=d}" Width="110"/>
        <DataGridTextColumn Header="Stock" Binding="{Binding StockOnHand}" Width="90"/>
        <DataGridTextColumn Header="Days" Binding="{Binding DaysRemaining}" Width="80"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Closings">
      <DataGrid ItemsSource="{Binding ClosingHistory}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate, StringFormat=d}" Width="110"/>
        <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="155"/>
        <DataGridTextColumn Header="Rev" Binding="{Binding Version}" Width="60"/>
        <DataGridTextColumn Header="Net Sales" Binding="{Binding NetSales, StringFormat=N2}" Width="110"/>
        <DataGridTextColumn Header="Net Profit" Binding="{Binding NetProfit, StringFormat=N2}" Width="110"/>
        <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedCash, StringFormat=N2}" Width="105"/>
        <DataGridTextColumn Header="Actual" Binding="{Binding ActualCash, StringFormat=N2}" Width="105"/>
        <DataGridTextColumn Header="Variance" Binding="{Binding Variance, StringFormat=N2}" Width="95"/>
        <DataGridTextColumn Header="Closed" Binding="{Binding ClosedAt, StringFormat=g}" Width="140"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Peak Hours">
      <DataGrid ItemsSource="{Binding PeakHours}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Hour" Binding="{Binding Hour, StringFormat={}{0}:00}" Width="100"/>
        <DataGridTextColumn Header="Sales" Binding="{Binding SalesCount}" Width="100"/>
        <DataGridTextColumn Header="Net Sales" Binding="{Binding NetSales, StringFormat=N2}" Width="140"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>

     <TabItem Header="Weekdays">
      <DataGrid ItemsSource="{Binding Weekdays}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Weekday" Binding="{Binding Weekday}" Width="*"/>
        <DataGridTextColumn Header="Sales" Binding="{Binding SalesCount}" Width="100"/>
        <DataGridTextColumn Header="Net Sales" Binding="{Binding NetSales, StringFormat=N2}" Width="140"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
    </TabControl>

    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" Margin="16,10,16,14"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>