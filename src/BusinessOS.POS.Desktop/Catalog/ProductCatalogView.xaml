<UserControl x:Class="BusinessOS.POS.Desktop.Catalog.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <TabControl>
            <TabItem Header="Products">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="18,16,18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38" Padding="10,0" VerticalContentAlignment="Center"
                                             ToolTip="Search SKU, English/Dari/Pashto name, or barcode" />
                                    <Button Grid.Column="2" Content="Search"
                                            Command="{Binding RefreshProductsCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Categories}"
                                              SelectedItem="{Binding SelectedFilterCategory}"
                                              DisplayMemberPath="Name"
                                              ToolTip="Category filter" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding SelectedStatus}" />
                                </Grid>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding SelectedProduct}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="105" />
                                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="86" />
                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockOnHand, StringFormat=N2}" Width="86" />
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="64" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="2" Margin="18,12,18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Content="New Product" Command="{Binding NewProductCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding CanManageProducts}" />
                                <Button Grid.Column="2" Content="Edit Selected"
                                        Command="{Binding EditSelectedProductCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProductEditorTitle}" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Base information, sellable units and barcodes" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource BrandPrimarySoftBrush}" CornerRadius="10" Padding="10,5">
                                        <TextBlock Text="{Binding StockOnHand, StringFormat=Stock: {0:N2}}" Foreground="{DynamicResource BrandPrimaryDarkBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="SKU" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding ProductSku}" Margin="0,4,0,10" />
                                        <TextBlock Text="English name" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding ProductNameEn}" Margin="0,4,0,10" />
                                        <TextBlock Text="Dari name" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding ProductNameFa}" Margin="0,4,0,10" />
                                        <TextBlock Text="Pashto name" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding ProductNamePs}" Margin="0,4,0,10" />
                                        <TextBlock Text="Category" Style="{StaticResource MutedTextStyle}" />
                                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedProductCategory}"
                                                  DisplayMemberPath="Name" Margin="0,4,0,10" />
                                        <TextBlock Text="Brand" Style="{StaticResource MutedTextStyle}" />
                                        <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedProductBrand}"
                                                  DisplayMemberPath="Name" Margin="0,4,0,10" />
                                        <TextBlock Text="Base unit" Style="{StaticResource MutedTextStyle}" />
                                        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedBaseUnit}"
                                                  DisplayMemberPath="Name" Margin="0,4,0,10" />
                                        <TextBlock Text="Shelf location" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding ShelfLocation}" Margin="0,4,0,10" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Purchase cost (AFN)" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding PurchaseCost}" Margin="0,4,0,10" />
                                        <TextBlock Text="Selling price (AFN)" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding SellingPrice}" Margin="0,4,0,10" />
                                        <TextBlock Text="Minimum selling price" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding MinimumSellingPrice}" Margin="0,4,0,10" />
                                        <TextBlock Text="Wholesale price" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding WholesalePrice}" Margin="0,4,0,10" />
                                        <TextBlock Text="Minimum stock" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding MinimumStock}" Margin="0,4,0,10" />
                                        <TextBlock Text="Reorder quantity" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding ReorderQuantity}" Margin="0,4,0,10" />
                                        <CheckBox Content="Track stock" IsChecked="{Binding TrackStock}" Margin="0,4,0,8" />
                                        <CheckBox Content="Track expiry" IsChecked="{Binding TrackExpiry}" Margin="0,0,0,8" />
                                        <CheckBox Content="Active product" IsChecked="{Binding ProductIsActive}" />
                                    </StackPanel>
                                </Grid>

                                <Expander Header="Descriptions" IsExpanded="False" Margin="0,8,0,12">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="English" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding DescriptionEn}" AcceptsReturn="True" Height="58" Margin="0,4,0,8" />
                                        <TextBlock Text="Dari" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding DescriptionFa}" AcceptsReturn="True" Height="58" Margin="0,4,0,8" />
                                        <TextBlock Text="Pashto" Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Text="{Binding DescriptionPs}" AcceptsReturn="True" Height="58" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Expander>

                                <TextBlock Text="Additional units" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,6" />
                                <TextBlock Text="The base unit is always configured at factor 1. Add cartons, packs, kilograms, liters, etc. only when needed."
                                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <DataGrid ItemsSource="{Binding ExtraUnits}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          MinHeight="120" MaxHeight="210">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Factor" Binding="{Binding ConversionFactor}" Width="75" />
                                        <DataGridCheckBoxColumn Header="Buy" Binding="{Binding CanPurchase}" Width="55" />
                                        <DataGridCheckBoxColumn Header="Sell" Binding="{Binding CanSell}" Width="55" />
                                        <DataGridTextColumn Header="Sale" Binding="{Binding SellingPrice}" Width="72" />
                                        <DataGridTextColumn Header="Min" Binding="{Binding MinimumSellingPrice}" Width="72" />
                                        <DataGridTextColumn Header="Whole." Binding="{Binding WholesalePrice}" Width="72" />
                                        <DataGridTemplateColumn Header="" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="×"
                                                            Command="{Binding DataContext.RemoveExtraUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Width="32" MinWidth="32" Height="28" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,8,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedExtraUnitToAdd}" DisplayMemberPath="Name" />
                                    <TextBox Grid.Column="2" Text="{Binding NewExtraUnitFactor}" ToolTip="Conversion factor" />
                                    <CheckBox Grid.Column="4" Content="Buy" IsChecked="{Binding NewExtraCanPurchase}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="6" Content="Sell" IsChecked="{Binding NewExtraCanSell}" VerticalAlignment="Center" />
                                    <Button Grid.Column="8" Content="Add Unit" Command="{Binding AddExtraUnitCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>

                                <TextBlock Text="Barcodes" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,6" />
                                <DataGrid ItemsSource="{Binding Barcodes}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          MinHeight="100" MaxHeight="190">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="*" />
                                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="120" IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="Primary" Binding="{Binding IsPrimary}" Width="70" />
                                        <DataGridTemplateColumn Header="" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="×"
                                                            Command="{Binding DataContext.RemoveBarcodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Width="32" MinWidth="32" Height="28" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,8,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewBarcode}" ToolTip="Barcode value" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding BarcodeUnitOptions}"
                                              SelectedItem="{Binding SelectedBarcodeUnit}" DisplayMemberPath="Name" />
                                    <CheckBox Grid.Column="4" Content="Primary" IsChecked="{Binding NewBarcodePrimary}" VerticalAlignment="Center" />
                                    <Button Grid.Column="6" Content="Add Barcode" Command="{Binding AddBarcodeCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>

                                <Button Content="Save Product"
                                        Command="{Binding SaveProductCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="44"
                                        IsEnabled="{Binding CanManageProducts}" />
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Categories">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryRow}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Sort" Binding="{Binding SortOrder}" Width="70" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Category editor" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="English name" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,0" />
                            <TextBox Text="{Binding CategoryNameEn}" Margin="0,4,0,10" />
                            <TextBlock Text="Dari name" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding CategoryNameFa}" Margin="0,4,0,10" />
                            <TextBlock Text="Pashto name" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding CategoryNamePs}" Margin="0,4,0,10" />
                            <TextBlock Text="Parent category" Style="{StaticResource MutedTextStyle}" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedParentCategory}"
                                      DisplayMemberPath="Name" Margin="0,4,0,10" />
                            <TextBlock Text="Sort order" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding CategorySortOrder}" Margin="0,4,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding CategoryIsActive}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Content="New" Command="{Binding NewCategoryCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="2" Content="Save" Command="{Binding SaveCategoryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanManageCatalog}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Brands">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrandRow}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Brand" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="English" Binding="{Binding NameEn}" Width="180" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Brand editor" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="English name" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,0" />
                            <TextBox Text="{Binding BrandNameEn}" Margin="0,4,0,10" />
                            <TextBlock Text="Dari name" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding BrandNameFa}" Margin="0,4,0,10" />
                            <TextBlock Text="Pashto name" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding BrandNamePs}" Margin="0,4,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding BrandIsActive}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Content="New" Command="{Binding NewBrandCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="2" Content="Save" Command="{Binding SaveBrandCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanManageCatalog}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Units">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnitRow}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="80" />
                                <DataGridTextColumn Header="Decimals" Binding="{Binding DecimalPlaces}" Width="80" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Unit editor" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Code" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,0" />
                            <TextBox Text="{Binding UnitCode}" Margin="0,4,0,10" />
                            <TextBlock Text="English name" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding UnitNameEn}" Margin="0,4,0,10" />
                            <TextBlock Text="Dari name" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding UnitNameFa}" Margin="0,4,0,10" />
                            <TextBlock Text="Pashto name" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding UnitNamePs}" Margin="0,4,0,10" />
                            <TextBlock Text="Symbol" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding UnitSymbol}" Margin="0,4,0,10" />
                            <TextBlock Text="Decimal places (0–6)" Style="{StaticResource MutedTextStyle}" />
                            <TextBox Text="{Binding UnitDecimalPlaces}" Margin="0,4,0,10" />
                            <CheckBox Content="Active" IsChecked="{Binding UnitIsActive}" Margin="0,0,0,14" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Content="New" Command="{Binding NewUnitCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="2" Content="Save" Command="{Binding SaveUnitCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanManageCatalog}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
