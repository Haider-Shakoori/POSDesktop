<UserControl x:Class="BusinessOS.POS.Desktop.Cash.CashView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnLoaded">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="EXPECTED CASH" Style="{StaticResource StatLabelStyle}"/>
    <TextBlock Text="{Binding CurrentExpectedCash, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="OPENING FLOAT" Style="{StaticResource StatLabelStyle}"/>
    <TextBlock Text="{Binding CurrentOpeningCash, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="INFLOWS" Style="{StaticResource StatLabelStyle}"/>
    <TextBlock Text="{Binding CurrentInflows, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="OUTFLOWS" Style="{StaticResource StatLabelStyle}"/>
    <TextBlock Text="{Binding CurrentOutflows, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/></StackPanel>
   </Border>
  </Grid>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardBorderStyle}" Padding="0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="250"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="16">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Cashier shifts" Style="{StaticResource SectionTitleStyle}"/>
       <TextBlock Text="Opening, closing and reconciliation history" Style="{StaticResource MutedTextStyle}"/></StackPanel>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
     </Grid>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Terminal" Binding="{Binding Terminal}" Width="*"/>
       <DataGridTextColumn Header="Cashier" Binding="{Binding UserName}" Width="130"/>
       <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
       <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedCash, StringFormat=N2}" Width="92"/>
       <DataGridTextColumn Header="Variance" Binding="{Binding Variance, StringFormat=N2}" Width="88"/>
       <DataGridTextColumn Header="Opened" Binding="{Binding OpenedAt, StringFormat=g}" Width="135"/>
      </DataGrid.Columns>
     </DataGrid>

     <Border Grid.Row="2" Background="{DynamicResource BrandPrimarySoftBrush}" Padding="14" Margin="16,12">
      <StackPanel>
       <TextBlock Text="Open shift" Style="{StaticResource SectionTitleStyle}"/>
       <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding Terminals}" SelectedItem="{Binding SelectedTerminal}" DisplayMemberPath="Name"/>
        <TextBox Grid.Column="2" Text="{Binding OpeningCash}" ToolTip="Opening cash AFN"/>
        <Button Grid.Column="4" Content="Open" Command="{Binding OpenShiftCommand}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanOpen}"/>
       </Grid>
      </StackPanel>
     </Border>

     <TabControl Grid.Row="3" Margin="16,0,16,16">
      <TabItem Header="Movements">
       <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Time" Binding="{Binding OccurredAt, StringFormat=g}" Width="140"/>
         <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="140"/>
         <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80"/>
         <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="88"/>
         <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedCashAfter, StringFormat=N2}" Width="90"/>
         <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="130"/>
         <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
      </TabItem>
      <TabItem Header="Closures">
       <DataGrid ItemsSource="{Binding Closures}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"/>
         <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedCash, StringFormat=N2}" Width="90"/>
         <DataGridTextColumn Header="Actual" Binding="{Binding ActualCash, StringFormat=N2}" Width="90"/>
         <DataGridTextColumn Header="Variance" Binding="{Binding Variance, StringFormat=N2}" Width="90"/>
         <DataGridCheckBoxColumn Header="Within" Binding="{Binding WithinTolerance}" Width="70"/>
         <DataGridTextColumn Header="Reason" Binding="{Binding VarianceReason}" Width="*"/>
         <DataGridTextColumn Header="Closed" Binding="{Binding ClosedAt, StringFormat=g}" Width="140"/>
        </DataGrid.Columns>
       </DataGrid>
      </TabItem>
     </TabControl>
    </Grid>
   </Border>

   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Style="{StaticResource CardBorderStyle}">
      <StackPanel>
       <TextBlock Text="Manual drawer movement" Style="{StaticResource SectionTitleStyle}"/>
       <TextBlock Text="Deposits, withdrawals and drawer-to-safe transfers are immutable ledger entries."
                  Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10"/>
       <ComboBox ItemsSource="{Binding ManualMovementTypes}" SelectedItem="{Binding SelectedManualMovementType}"/>
       <TextBox Text="{Binding ManualAmount}" ToolTip="Amount AFN" Margin="0,8,0,0"/>
       <TextBox Text="{Binding ManualReason}" ToolTip="Reason" Margin="0,8,0,0"/>
       <Button Content="Record Movement" Command="{Binding RecordManualMovementCommand}"
               Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanManageCash}" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
      <StackPanel>
       <TextBlock Text="Close current shift" Style="{StaticResource SectionTitleStyle}"/>
       <TextBlock Text="{Binding CurrentExpectedCash, StringFormat=Expected drawer cash: AFN {0:N2}}"
                  Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10"/>
       <TextBox Text="{Binding ActualCash}" ToolTip="Counted actual cash AFN"/>
       <TextBox Text="{Binding VarianceReason}" ToolTip="Variance reason (required when difference exists)" Margin="0,8,0,0"/>
       <TextBox Text="{Binding ClosingNotes}" ToolTip="Closing notes" AcceptsReturn="True" Height="55" Margin="0,8,0,0"/>
       <Button Content="Close Shift" Command="{Binding CloseShiftCommand}"
               Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanClose}" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
      <StackPanel>
       <TextBlock Text="Reopen selected shift" Style="{StaticResource SectionTitleStyle}"/>
       <TextBlock Text="Requires the shift reopen permission and no conflicting open cashier or terminal shift."
                  Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10"/>
       <TextBox Text="{Binding ReopenReason}" ToolTip="Reopen reason"/>
       <Button Content="Reopen Shift" Command="{Binding ReopenShiftCommand}"
               Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanReopen}" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>