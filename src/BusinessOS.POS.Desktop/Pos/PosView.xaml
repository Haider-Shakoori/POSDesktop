<UserControl x:Class="BusinessOS.POS.Desktop.Pos.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.35*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Product search / barcode" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="F2 focuses search. Scan a barcode and press Enter to add it instantly."
                               Style="{StaticResource MutedTextStyle}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchInput"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnSearchKeyDown" />
                        <Button Grid.Column="2"
                                Content="Search"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding SearchResults}"
                          SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          MouseDoubleClick="OnResultDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="85" />
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding AvailableQuantity, StringFormat=N2}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cashier shift" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding ShiftStatus}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="12" Padding="10,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShiftOpen}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ShiftStatus}" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,12,0,0" IsEnabled="{Binding CanOpenShift}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged}"
                                 Height="38" Padding="10,0" VerticalContentAlignment="Center"
                                 ToolTip="Opening cash in AFN" />
                        <Button Grid.Column="2"
                                Content="Open Shift"
                                Command="{Binding OpenShiftCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,16,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Current sale" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding LastSaleNumber, StringFormat=Last: {0}, TargetNullValue=No completed sale yet}"
                                       Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Add Selected"
                                    Command="{Binding AddSelectedCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="Clear"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Cart}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Price" Binding="{Binding Product.Price, StringFormat=N2}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="Total" Binding="{Binding NetTotal, StringFormat=N2}" Width="90" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="34" MinWidth="34" Height="30" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Held sales" Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox ItemsSource="{Binding HeldSales}"
                                  SelectedItem="{Binding SelectedHeldSale}"
                                  DisplayMemberPath="Number"
                                  Margin="0,10,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Content="Hold · F8"
                                    Command="{Binding HoldCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="2"
                                    Content="Resume"
                                    Command="{Binding ResumeHeldCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="4"
                                    Content="Release"
                                    Command="{Binding ReleaseHeldCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <TextBlock Text="Sale notes" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,3" />
                        <TextBox Text="{Binding SaleNotes}" Height="46" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                        <Button Content="{Binding LastSaleNumber, StringFormat=Print Receipt · {0}, TargetNullValue=Print Last Receipt}"
                                Command="{Binding PrintLastReceiptCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,10,0,0" />

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=AFN {0:N2}}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Line discounts" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding LineDiscountTotal, StringFormat=AFN {0:N2}}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sale discount" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SaleDiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanDiscount}"
                                     Height="34" Padding="8,0" VerticalContentAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL" FontSize="15" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource BrandPrimaryBrush}" />
                        </Grid>

                        <TextBlock Text="Payments" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                        <DataGrid ItemsSource="{Binding Payments}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  MaxHeight="132"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Method" Binding="{Binding MethodName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Applied" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="82" />
                                <DataGridTextColumn Header="Tendered" Binding="{Binding TenderedAmount, UpdateSourceTrigger=PropertyChanged}" Width="82" />
                                <DataGridTextColumn Header="Ref" Binding="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                                <DataGridTemplateColumn Header="" Width="46">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×"
                                                    Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Width="30" MinWidth="30" Height="26" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding PaymentMethods}"
                                      SelectedItem="{Binding SelectedPaymentMethodToAdd}"
                                      DisplayMemberPath="Name" />
                            <Button Grid.Column="2"
                                    Content="Add Payment"
                                    Command="{Binding AddPaymentCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding PaymentSummaryText}" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding AppliedPaymentTotal, StringFormat=Applied: AFN {0:N2}}"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Change" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ChangeAmount, StringFormat=AFN {0:N2}}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Button Content="Complete Sale · F9 / Ctrl+Enter"
                                Command="{Binding CheckoutCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="46" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
