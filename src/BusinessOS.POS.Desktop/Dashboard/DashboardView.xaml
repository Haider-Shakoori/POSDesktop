<UserControl x:Class="BusinessOS.POS.Desktop.Dashboard.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnLoaded">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="0,0,8,24">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/>
     <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
     <StackPanel><TextBlock Text="TODAY'S NET SALES" Style="{StaticResource StatLabelStyle}"/>
      <TextBlock Text="{Binding TodayNetSales, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/>
      <TextBlock Text="{Binding TodayTransactions, StringFormat={}{0} transactions}" Style="{StaticResource MutedTextStyle}"/></StackPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
     <StackPanel><TextBlock Text="CASH ON HAND" Style="{StaticResource StatLabelStyle}"/>
      <TextBlock Text="{Binding CashOnHand, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/>
      <TextBlock Text="{Binding ShiftStatus}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Border>
    <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
     <StackPanel><TextBlock Text="RECEIVABLES" Style="{StaticResource StatLabelStyle}"/>
      <TextBlock Text="{Binding Receivables, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/>
      <TextBlock Text="Customer balances" Style="{StaticResource MutedTextStyle}"/></StackPanel>
    </Border>
    <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}">
     <StackPanel><TextBlock Text="PAYABLES" Style="{StaticResource StatLabelStyle}"/>
      <TextBlock Text="{Binding Payables, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/>
      <TextBlock Text="Supplier balances" Style="{StaticResource MutedTextStyle}"/></StackPanel>
    </Border>
    <Border Grid.Column="8" Style="{StaticResource CardBorderStyle}">
     <StackPanel><TextBlock Text="LOW STOCK" Style="{StaticResource StatLabelStyle}"/>
      <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource StatValueStyle}"/>
      <TextBlock Text="Tracked products at/below minimum" Style="{StaticResource MutedTextStyle}"/></StackPanel>
    </Border>
   </Grid>

   <Grid Margin="0,14,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/></Grid.RowDefinitions>
      <Grid Margin="16">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Recent sales" Style="{StaticResource SectionTitleStyle}"/>
        <TextBlock Text="Latest completed transactions" Style="{StaticResource MutedTextStyle}"/></StackPanel>
       <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
      </Grid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding RecentSales}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="125"/>
        <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*"/>
        <DataGridTextColumn Header="Net" Binding="{Binding NetTotal, StringFormat=N2}" Width="95"/>
        <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedTotal, StringFormat=N2}" Width="90"/>
        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentStatus}" Width="90"/>
        <DataGridTextColumn Header="Sold" Binding="{Binding SoldAt, StringFormat=g}" Width="135"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/></Grid.RowDefinitions>
      <StackPanel Margin="16">
       <TextBlock Text="Low-stock watch" Style="{StaticResource SectionTitleStyle}"/>
       <TextBlock Text="Products requiring replenishment attention" Style="{StaticResource MutedTextStyle}"/>
      </StackPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="105"/>
        <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
        <DataGridTextColumn Header="Stock" Binding="{Binding StockOnHand, StringFormat=N2}" Width="85"/>
        <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumStock, StringFormat=N2}" Width="85"/>
        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
   </Grid>

   <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="BusinessOS POS live overview" Style="{StaticResource SectionTitleStyle}"/>
      <TextBlock Text="AFN only · no tax · offline-first · English / دری / پښتو" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/></StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
    </Grid>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>