<UserControl x:Class="BusinessOS.POS.Desktop.Dashboard.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnLoaded">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="0,0,8,24">
   <Grid Margin="0,0,0,18">
    <Grid.ColumnDefinitions>
     <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/>
     <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
     <StackPanel>
      <TextBlock Text="TODAY'S NET SALES" Style="{StaticResource StatLabelStyle}"/>
      <TextBlock Text="{Binding TodayNetSales, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/>
      <TextBlock Text="{Binding TodayTransactions, StringFormat={}{0} transactions}" Style="{StaticResource MutedTextStyle}"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
     <StackPanel>
      <TextBlock Text="CURRENT DRAWER" Style="{StaticResource StatLabelStyle}"/>
      <TextBlock Text="{Binding CurrentShiftExpectedCash, StringFormat=AFN {0:N2}}" Style="{StaticResource StatValueStyle}"/>
      <TextBlock Text="{Binding CurrentShiftTerminal}" Style="{StaticResource MutedTextStyle}"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
     <StackPanel>
      <TextBlock Text="RECEIVABLES / PAYABLES" Style="{StaticResource StatLabelStyle}"/>
      <TextBlock Text="{Binding Receivables, StringFormat=AR AFN {0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock Text="{Binding Payables, StringFormat=AP AFN {0:N2}}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}">
     <StackPanel>
      <TextBlock Text="LOW STOCK" Style="{StaticResource StatLabelStyle}"/>
      <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource StatValueStyle}"/>
      <TextBlock Text="Products at or below minimum" Style="{StaticResource MutedTextStyle}"/>
     </StackPanel>
    </Border>
   </Grid>

   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="16">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Recent sales" Style="{StaticResource SectionTitleStyle}"/>
        <TextBlock Text="Latest completed POS transactions" Style="{StaticResource MutedTextStyle}"/>
       </StackPanel>
       <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
      </Grid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding RecentSales}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="300">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="145"/>
        <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*"/>
        <DataGridTextColumn Header="Total" Binding="{Binding NetTotal, StringFormat=N2}" Width="95"/>
        <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedTotal, StringFormat=N2}" Width="95"/>
        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentStatus}" Width="100"/>
        <DataGridTextColumn Header="Sold" Binding="{Binding SoldAt, StringFormat=g}" Width="140"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="16">
       <TextBlock Text="Low-stock watch" Style="{StaticResource SectionTitleStyle}"/>
       <TextBlock Text="Fast replenishment visibility for supermarket stock" Style="{StaticResource MutedTextStyle}"/>
      </StackPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="300">
       <DataGrid.Columns>
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="105"/>
        <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
        <DataGridTextColumn Header="On hand" Binding="{Binding StockOnHand}" Width="80"/>
        <DataGridTextColumn Header="Min" Binding="{Binding MinimumStock}" Width="70"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" Margin="16,10,16,16"/>
     </Grid>
    </Border>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>