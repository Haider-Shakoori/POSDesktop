<UserControl x:Class="BusinessOS.POS.Desktop.Terminals.TerminalsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnLoaded">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource CardBorderStyle}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Deployment mode" Style="{StaticResource MutedTextStyle}"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Main server name" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding ServerName}" Margin="0,4,0,0"/></StackPanel>
    <Button Grid.Column="4" Content="Save mode" Command="{Binding SaveModeCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
   </Grid>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Server host" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding ServerHost}" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Port" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding ServerPort}" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="4"><TextBlock Text="Terminal name" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding TerminalName}" Margin="0,4,0,0"/></StackPanel>
    <Button Grid.Column="6" Content="Test connection" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
   </Grid>
  </Border>
  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardBorderStyle}">
    <StackPanel>
     <TextBlock Text="PAIRING" Style="{StaticResource SectionTitleStyle}"/>
     <TextBlock Text="On the Main POS Server generate a one-time 10 minute code. On a client, enter the server identity, pinned certificate fingerprint and code." TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,14"/>
     <Button Content="Generate pairing code" Command="{Binding CreatePairingCodeCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
     <TextBox Text="{Binding PairingCode}" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
     <TextBlock Text="Server ID" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,0"/><TextBox Text="{Binding ServerId}" Margin="0,4,0,0"/>
     <TextBlock Text="Certificate SHA-256" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0"/><TextBox Text="{Binding CertificateSha256}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     <Button Content="Pair this client" Command="{Binding PairClientCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,14,0,0"/>
     <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="REGISTERED TERMINALS" Style="{StaticResource SectionTitleStyle}"/><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshTerminalsCommand}" Style="{StaticResource SecondaryButtonStyle}"/></DockPanel>
     <DataGrid Grid.Row="2" ItemsSource="{Binding Terminals}" SelectedItem="{Binding SelectedTerminal}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="180"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/><DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenAt, StringFormat=g}" Width="150"/></DataGrid.Columns>
     </DataGrid>
     <Button Grid.Row="4" Content="Revoke selected terminal" Command="{Binding RevokeSelectedCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
