<UserControl x:Class="BusinessOS.POS.Desktop.Networking.NetworkSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnLoaded">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="DEPLOYMENT MODE" Style="{StaticResource StatLabelStyle}"/>
     <TextBlock Text="{Binding Mode}" Style="{StaticResource StatValueStyle}"/>
     <TextBlock Text="Standalone / Server / Client" Style="{StaticResource MutedTextStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="SERVER ID" Style="{StaticResource StatLabelStyle}"/>
     <TextBlock Text="{Binding ServerId, TargetNullValue=Not initialized}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="Persistent identity" Style="{StaticResource MutedTextStyle}"/></StackPanel>
   </Border>
   <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
    <StackPanel><TextBlock Text="CONNECTION" Style="{StaticResource StatLabelStyle}"/>
     <TextBlock Text="{Binding ConnectionStatus}" FontSize="16" FontWeight="Bold"/>
     <TextBlock Text="TLS pinned · LAN only" Style="{StaticResource MutedTextStyle}"/></StackPanel>
   </Border>
  </Grid>

  <TabControl Grid.Row="2">
   <TabItem Header="Main Server">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="16">
      <Border Style="{StaticResource CardBorderStyle}">
       <StackPanel>
        <TextBlock Text="Main POS Server" Style="{StaticResource SectionTitleStyle}"/>
        <TextBlock Text="This workstation keeps the authoritative SQLite database. Client terminals never open it over a file share."
                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Server name" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding ServerName}" Margin="0,3,0,0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="HTTPS port" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding ServerPort}" Margin="0,3,0,0"/></StackPanel>
        </Grid>
        <Grid Margin="0,10,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Discovery UDP port" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding DiscoveryPort}" Margin="0,3,0,0"/></StackPanel>
         <CheckBox Grid.Column="2" IsChecked="{Binding DiscoveryEnabled}" Content="Enable safe LAN discovery" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
         <Button Content="Configure Main Server" Command="{Binding SaveServerCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
         <Button Content="Use Standalone" Command="{Binding SaveStandaloneCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Pairing code" Style="{StaticResource SectionTitleStyle}"/>
         <TextBlock Text="Six digits · one time · five minutes · attempt limited" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding IssuedPairingCode}" FontSize="30" FontWeight="Black" Margin="0,12,0,0"/>
         <TextBlock Text="{Binding PairingExpiry, StringFormat=Expires: {0}}" Style="{StaticResource MutedTextStyle}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Issue Pairing Code" Command="{Binding IssuePairingCodeCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/>
       </Grid>
      </Border>

      <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,14,0,0">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="250"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="16"><TextBlock Text="Registered terminals" Style="{StaticResource SectionTitleStyle}"/>
         <TextBlock Text="Each paired workstation receives its own cashier terminal and can be revoked centrally." Style="{StaticResource MutedTextStyle}"/></StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding RegisteredTerminals}" SelectedItem="{Binding SelectedTerminal}" AutoGenerateColumns="False" IsReadOnly="True">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="150"/>
          <DataGridTextColumn Header="Role" Binding="{Binding TerminalRole}" Width="120"/>
          <DataGridTextColumn Header="Cash Terminal" Binding="{Binding CashTerminalId}" Width="100"/>
          <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
          <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenAt, StringFormat=g}" Width="145"/>
         </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,16,16">
         <Button Content="Revoke" Command="{Binding RevokeTerminalCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
         <Button Content="Reactivate" Command="{Binding ReactivateTerminalCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
       </Grid>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <TabItem Header="Client Pairing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="16">
      <Border Style="{StaticResource CardBorderStyle}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Find Main POS Server" Style="{StaticResource SectionTitleStyle}"/>
         <TextBlock Text="Discovery broadcasts only server identity, hostname, port and certificate fingerprint." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        <Button Grid.Column="1" Content="Discover" Command="{Binding DiscoverCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center"/>
       </Grid>
      </Border>

      <DataGrid ItemsSource="{Binding DiscoveredServers}" SelectedItem="{Binding SelectedServer}" AutoGenerateColumns="False" IsReadOnly="True" Height="180" Margin="0,14,0,0">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="*"/>
        <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="160"/>
        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
        <DataGridTextColumn Header="Server ID" Binding="{Binding ServerId}" Width="210"/>
       </DataGrid.Columns>
      </DataGrid>

      <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
       <StackPanel>
        <TextBlock Text="Manual / selected server identity" Style="{StaticResource SectionTitleStyle}"/>
        <Grid Margin="0,10,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Host / IP" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding ManualHost}" Margin="0,3,0,0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Server ID" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding ManualServerId}" Margin="0,3,0,0"/></StackPanel>
        </Grid>
        <TextBlock Text="TLS SHA-256 fingerprint" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0"/>
        <TextBox Text="{Binding ManualFingerprint}" Margin="0,3,0,0"/>
        <Grid Margin="0,10,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Terminal name" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding TerminalName}" Margin="0,3,0,0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Terminal role" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding TerminalRole}" Margin="0,3,0,0"/></StackPanel>
        </Grid>
        <TextBlock Text="One-time pairing code" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0"/>
        <TextBox Text="{Binding PairingCode}" FontSize="20" MaxLength="6" Margin="0,3,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
         <Button Content="Pair This Terminal" Command="{Binding PairCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
         <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <TabItem Header="Security">
    <Border Style="{StaticResource CardBorderStyle}" Margin="16" VerticalAlignment="Top">
     <StackPanel>
      <TextBlock Text="LAN security model" Style="{StaticResource SectionTitleStyle}"/>
      <TextBlock Text="• HTTPS only with SHA-256 certificate pinning&#x0a;• Persistent Server UUID and Terminal UUID&#x0a;• 256-bit terminal secret stored with Windows DPAPI&#x0a;• One-time hashed pairing codes with expiry and attempt limits&#x0a;• Separate POS-user login and terminal-bound expiring session&#x0a;• Server-side role/permission checks plus optional terminal restrictions&#x0a;• Revocation disables the workstation cashier terminal and invalidates active LAN sessions&#x0a;• Client terminals never open businessos-pos.db directly"
                 TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </TabItem>
  </TabControl>

  <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,18,12" Background="{DynamicResource CardBrush}" Padding="12,7" CornerRadius="8">
   <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}"/>
  </Border>
 </Grid>
</UserControl>