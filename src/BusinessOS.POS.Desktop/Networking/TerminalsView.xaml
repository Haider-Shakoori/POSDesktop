<UserControl x:Class="BusinessOS.POS.Desktop.Networking.TerminalsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnLoaded">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource CardBorderStyle}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Deployment mode" Style="{StaticResource MutedTextStyle}"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Server name" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding ServerName}" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="4"><TextBlock Text="Server / discovery ports" Style="{StaticResource MutedTextStyle}"/>
     <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBox Text="{Binding ServerPort}" Width="90"/><TextBox Text="{Binding DiscoveryPort}" Width="90" Margin="8,0,0,0"/></StackPanel></StackPanel>
    <Button Grid.Column="6" Content="Save" Command="{Binding SaveConfigurationCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
   </Grid>
  </Border>

  <TabControl Grid.Row="2">
   <TabItem Header="Server Terminals">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CardBorderStyle}" Padding="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel Margin="16"><TextBlock Text="Registered LAN terminals" Style="{StaticResource SectionTitleStyle}"/>
        <TextBlock Text="The Main POS Server is the only database authority. Revoked terminals lose access immediately." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel>
       <DataGrid Grid.Row="1" ItemsSource="{Binding Terminals}" SelectedItem="{Binding SelectedTerminal}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
         <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="145"/>
         <DataGridTextColumn Header="Role" Binding="{Binding TerminalRole}" Width="120"/>
         <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
         <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenAt, StringFormat=g}" Width="140"/>
         <DataGridTextColumn Header="Registered" Binding="{Binding RegisteredAt, StringFormat=g}" Width="140"/>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </Border>
     <StackPanel Grid.Column="2">
      <Border Style="{StaticResource CardBorderStyle}">
       <StackPanel>
        <TextBlock Text="Pair a new terminal" Style="{StaticResource SectionTitleStyle}"/>
        <TextBlock Text="Generate a one-time six-digit code on this server, then enter it on the client workstation." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <Button Content="Create 5-minute Pairing Code" Command="{Binding CreatePairingCodeCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
        <TextBlock Text="{Binding IssuedPairingCode}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding PairingExpiresAt, StringFormat=Expires: {0:g}}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"/>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12"/>
        <TextBlock Text="{Binding ConfiguredServerId, StringFormat=Server ID: {0}}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ConfiguredServerCertificateSha256, StringFormat=Certificate SHA-256: {0}}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
       <StackPanel>
        <TextBlock Text="Selected terminal" Style="{StaticResource SectionTitleStyle}"/>
        <Button Content="Revoke Access" Command="{Binding RevokeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </TabItem>

   <TabItem Header="Client Pairing">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CardBorderStyle}" Padding="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Discover Main POS Server" Style="{StaticResource SectionTitleStyle}"/>
         <TextBlock Text="Discovery stays on the local network; HTTPS certificate fingerprints are pinned during pairing." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel>
        <Button Grid.Column="1" Content="Discover" Command="{Binding DiscoverCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
       </Grid>
       <DataGrid Grid.Row="1" ItemsSource="{Binding DiscoveredServers}" SelectedItem="{Binding SelectedDiscoveredServer}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="*"/>
         <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="150"/>
         <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
         <DataGridTextColumn Header="Server ID" Binding="{Binding ServerId}" Width="210"/>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </Border>

     <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
      <StackPanel>
       <TextBlock Text="Secure client pairing" Style="{StaticResource SectionTitleStyle}"/>
       <TextBlock Text="Pairing creates a unique terminal secret stored with Windows DPAPI. The SQLite database is never shared over the LAN." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12"/>
       <TextBlock Text="Terminal name" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding TerminalName}" Margin="0,3,0,0"/>
       <TextBlock Text="Terminal role" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/><TextBox Text="{Binding TerminalRole}" Margin="0,3,0,0"/>
       <TextBlock Text="Pairing code" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/><TextBox Text="{Binding PairingCode}" Margin="0,3,0,0"/>
       <Expander Header="Manual server fallback" Margin="0,10,0,0">
        <StackPanel Margin="0,8,0,0">
         <TextBlock Text="Use this only when UDP discovery is blocked. Copy the server ID and SHA-256 fingerprint from the Main POS Server." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
         <TextBox Text="{Binding ManualServerName}" ToolTip="Server name" Margin="0,8,0,0"/>
         <TextBox Text="{Binding ManualServerHost}" ToolTip="Server host or IP" Margin="0,6,0,0"/>
         <TextBox Text="{Binding ManualServerPort}" ToolTip="Server port" Margin="0,6,0,0"/>
         <TextBox Text="{Binding ManualServerId}" ToolTip="Server UUID" Margin="0,6,0,0"/>
         <TextBox Text="{Binding ManualCertificateSha256}" ToolTip="Certificate SHA-256 fingerprint" Margin="0,6,0,0"/>
         <Button Content="Use Manual Server" Command="{Binding UseManualServerCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"/>
        </StackPanel>
       </Expander>
       <Button Content="Pair This Workstation" Command="{Binding PairCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,12,0,0"/>
       <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14"/>
       <TextBlock Text="{Binding ConfiguredServerHost, StringFormat=Configured server: {0}}" Style="{StaticResource MutedTextStyle}"/>
       <TextBlock Text="{Binding ConfiguredServerId, StringFormat=Server ID: {0}}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
       <TextBlock Text="{Binding ConfiguredTerminalId, StringFormat=Terminal ID: {0}}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>
   </TabItem>
  </TabControl>

  <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,18,18" Padding="12,8" CornerRadius="12" Background="{DynamicResource BrandPrimarySoftBrush}">
   <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrandPrimaryDarkBrush}"/>
  </Border>
 </Grid>
</UserControl>