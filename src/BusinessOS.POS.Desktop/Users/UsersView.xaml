<UserControl x:Class="BusinessOS.POS.Desktop.Users.UsersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnLoaded">
 <Grid>
  <TabControl>
   <TabItem Header="Users">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CardBorderStyle}" Padding="0">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/><ColumnDefinition Width="8"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Users" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Local staff accounts and assigned access roles" Style="{StaticResource MutedTextStyle}"/></StackPanel>
        <Button Grid.Column="1" Content="New User" Command="{Binding NewUserCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
       </Grid>
       <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
         <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="130"/>
         <DataGridTextColumn Header="Roles" Binding="{Binding Roles}" Width="220"/>
         <DataGridTextColumn Header="Language" Binding="{Binding PreferredLocale}" Width="80"/>
         <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </Border>

     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <Border Style="{StaticResource CardBorderStyle}">
       <StackPanel>
        <TextBlock Text="{Binding UserEditorTitle}" Style="{StaticResource SectionTitleStyle}"/>
        <TextBlock Text="Name" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,3"/><TextBox Text="{Binding UserName}"/>
        <TextBlock Text="Username" Style="{StaticResource MutedTextStyle}" Margin="0,9,0,3"/><TextBox Text="{Binding Username}"/>
        <TextBlock Text="Email" Style="{StaticResource MutedTextStyle}" Margin="0,9,0,3"/><TextBox Text="{Binding Email}"/>
        <TextBlock Text="Preferred language" Style="{StaticResource MutedTextStyle}" Margin="0,9,0,3"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding PreferredLocale}"/>
        <CheckBox Content="Active user" IsChecked="{Binding UserIsActive}" Margin="0,10,0,0"/>
        <TextBlock Text="Roles" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,4"/>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MaxHeight="170">
         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding UserRoles}">
           <ItemsControl.ItemTemplate>
            <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="2,4"/></DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </ScrollViewer>
        </Border>
        <TextBlock Text="Password / reset password" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,3"/>
        <PasswordBox x:Name="UserPasswordBox" PasswordChanged="OnUserPasswordChanged"/>
        <Grid Margin="0,12,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Button Content="Save User" Command="{Binding SaveUserCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
         <Button Grid.Column="2" Content="Reset Password" Command="{Binding ResetPasswordCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        </Grid>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
     </ScrollViewer>
    </Grid>
   </TabItem>

   <TabItem Header="Roles &amp; Permissions">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource CardBorderStyle}" Padding="0">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Roles" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="System roles are seeded from the POS permission matrix; custom roles are editable." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel>
        <Button Grid.Column="1" Content="New Custom Role" Command="{Binding NewRoleCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
       </Grid>
       <DataGrid Grid.Row="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Role" Binding="{Binding Label}" Width="*"/>
         <DataGridTextColumn Header="Code" Binding="{Binding Name}" Width="150"/>
         <DataGridCheckBoxColumn Header="System" Binding="{Binding IsSystem}" Width="70"/>
         <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="2*"/>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </Border>

     <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel>
        <TextBlock Text="{Binding RoleEditorTitle}" Style="{StaticResource SectionTitleStyle}"/>
        <TextBlock Text="System roles are read-only because their permissions are restored from the canonical POS role matrix at startup." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       </StackPanel>
       <Grid Grid.Row="1" Margin="0,14,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Role code" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding RoleName}" IsEnabled="{Binding CanEditRole}" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Label" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding RoleLabel}" IsEnabled="{Binding CanEditRole}" Margin="0,3,0,0"/></StackPanel>
       </Grid>
       <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <ItemsControl ItemsSource="{Binding RolePermissions}" IsEnabled="{Binding CanEditRole}">
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected}" Margin="2,4">
             <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Style="{StaticResource MutedTextStyle}"/></StackPanel>
            </CheckBox>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
       </Border>
       <Button Grid.Row="3" Content="Save Custom Role" Command="{Binding SaveRoleCommand}" IsEnabled="{Binding CanEditRole}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="150" Margin="0,12,0,0"/>
      </Grid>
     </Border>
    </Grid>
   </TabItem>

   <TabItem Header="Audit">
    <TabItem.Style>
     <Style TargetType="TabItem">
      <Setter Property="Visibility" Value="Visible"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding CanViewAudit}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers>
     </Style>
    </TabItem.Style>
    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="16"><TextBlock Text="Audit history" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Latest authentication, access-control and business events" Style="{StaticResource MutedTextStyle}"/></StackPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Audit}" AutoGenerateColumns="False" IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt, StringFormat=g}" Width="150"/>
        <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="150"/>
        <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="220"/>
        <DataGridTextColumn Header="Details" Binding="{Binding DetailsJson}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>