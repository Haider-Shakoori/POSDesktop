<UserControl x:Class="BusinessOS.POS.Desktop.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.25*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="18,16,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="38" Padding="10,0" VerticalContentAlignment="Center"
                             ToolTip="Search name or phone" />
                    <Button Grid.Column="2" Content="Search"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="Limit" Binding="{Binding CreditLimit, StringFormat=N2}" Width="90" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="62" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2" Margin="18,12,18,16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Content="New Customer" Command="{Binding NewCustomerCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Column="2">
            <TabItem Header="Profile">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding CustomerEditorTitle}" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Name" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding CustomerName}" Margin="0,4,0,10" />
                                    <TextBlock Text="Phone" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding Phone}" Margin="0,4,0,10" />
                                    <TextBlock Text="Alternate phone" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding AlternatePhone}" Margin="0,4,0,10" />
                                    <TextBlock Text="Address" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding Address}" AcceptsReturn="True" Height="70" Margin="0,4,0,10" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Credit limit (AFN)" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding CreditLimit}" Margin="0,4,0,10" />
                                    <TextBlock Text="Opening balance (AFN)" Style="{StaticResource MutedTextStyle}" />
                                    <TextBox Text="{Binding OpeningBalance}" Margin="0,4,0,10" />
                                    <CheckBox Content="Active customer" IsChecked="{Binding CustomerIsActive}" Margin="0,2,0,12" />
                                    <Border Background="{DynamicResource BrandPrimarySoftBrush}" CornerRadius="10" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CurrentBalance, StringFormat=Current balance: AFN {0:N2}}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AvailableCredit, StringFormat=Available credit: AFN {0:N2}}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Button Content="Save Customer" Command="{Binding SaveCustomerCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="42"
                                    IsEnabled="{Binding CanManage}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Ledger">
                <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,14,0,0">
                    <DataGrid ItemsSource="{Binding Ledger}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding OccurredAt, StringFormat=g}" Width="140" />
                            <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="110" />
                            <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="80" />
                            <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="80" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="130" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="Outstanding">
                <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,14,0,0">
                    <DataGrid ItemsSource="{Binding OutstandingSales}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sale" Binding="{Binding SaleNumber}" Width="145" />
                            <DataGridTextColumn Header="Sold" Binding="{Binding SoldAt, StringFormat=g}" Width="140" />
                            <DataGridTextColumn Header="Total" Binding="{Binding NetTotal, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat=N2}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="Collections">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Record collection" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Method" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,0" />
                                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                                          DisplayMemberPath="Name" Margin="0,4,0,10" />
                                <TextBlock Text="Amount (AFN)" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding CollectionAmount}" Margin="0,4,0,10" />
                                <TextBlock Text="Tendered (AFN)" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding CollectionTenderedAmount}" Margin="0,4,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Reference" Style="{StaticResource MutedTextStyle}" Margin="0,34,0,0" />
                                <TextBox Text="{Binding CollectionReference}" Margin="0,4,0,10" />
                                <TextBlock Text="Notes" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding CollectionNotes}" AcceptsReturn="True" Height="62" Margin="0,4,0,10" />
                                <Button Content="Record Collection" Command="{Binding CollectCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="40"
                                        IsEnabled="{Binding CanCollect}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding Collections}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="145" />
                                <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="120" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="85" />
                                <DataGridTextColumn Header="Tendered" Binding="{Binding TenderedAmount, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Change" Binding="{Binding ChangeAmount, StringFormat=N2}" Width="80" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="120" />
                                <DataGridTextColumn Header="Collected" Binding="{Binding CollectedAt, StringFormat=g}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,14,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" MaxWidth="520" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
