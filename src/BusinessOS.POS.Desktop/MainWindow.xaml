<Window x:Class="BusinessOS.POS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pos="clr-namespace:BusinessOS.POS.Desktop.Pos"
        xmlns:catalog="clr-namespace:BusinessOS.POS.Desktop.Catalog"
        xmlns:cash="clr-namespace:BusinessOS.POS.Desktop.Cash"
        xmlns:closing="clr-namespace:BusinessOS.POS.Desktop.Closing"
        xmlns:dashboard="clr-namespace:BusinessOS.POS.Desktop.Dashboard"
        xmlns:reports="clr-namespace:BusinessOS.POS.Desktop.Reports"
        xmlns:expenses="clr-namespace:BusinessOS.POS.Desktop.Expenses"
        xmlns:inventory="clr-namespace:BusinessOS.POS.Desktop.Inventory"
        xmlns:sales="clr-namespace:BusinessOS.POS.Desktop.Sales"
        xmlns:customers="clr-namespace:BusinessOS.POS.Desktop.Customers"
        xmlns:purchasing="clr-namespace:BusinessOS.POS.Desktop.Purchasing"
        xmlns:terminals="clr-namespace:BusinessOS.POS.Desktop.Terminals"
        xmlns:settings="clr-namespace:BusinessOS.POS.Desktop.Settings"
        xmlns:users="clr-namespace:BusinessOS.POS.Desktop.Users"
        Title="BusinessOS POS"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FlowDirection="{Binding FlowDirection}">
    <Window.Resources>
        <DataTemplate x:Key="DashboardTemplate">
            <dashboard:DashboardView DataContext="{Binding DataContext.Dashboard, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="PosTemplate">
            <pos:PosView DataContext="{Binding DataContext.Pos, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="ProductCatalogTemplate">
            <catalog:ProductCatalogView DataContext="{Binding DataContext.Catalog, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="InventoryTemplate">
            <inventory:InventoryView DataContext="{Binding DataContext.Inventory, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="SalesTemplate">
            <sales:SalesView DataContext="{Binding DataContext.Sales, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="CustomersTemplate">
            <customers:CustomersView DataContext="{Binding DataContext.Customers, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="PurchasingTemplate">
            <purchasing:PurchasingView DataContext="{Binding DataContext.Purchasing, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="CashTemplate">
            <cash:CashView DataContext="{Binding DataContext.Cash, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="ClosingTemplate">
            <closing:DailyClosingView DataContext="{Binding DataContext.Closing, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="ExpensesTemplate">
            <expenses:ExpensesView DataContext="{Binding DataContext.Expenses, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="ReportsTemplate">
            <reports:ReportsView DataContext="{Binding DataContext.Reports, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="TerminalsTemplate">
            <terminals:TerminalsView DataContext="{Binding DataContext.Terminals, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="SettingsTemplate">
            <settings:SettingsView DataContext="{Binding DataContext.Settings, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="UsersTemplate">
            <users:UsersView DataContext="{Binding DataContext.Users, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>

        <DataTemplate x:Key="ModuleTemplate">
            <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.SelectedNavigation.Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding DataContext.SelectedNavigation.Subtitle, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,18" />
                    <Border Background="{DynamicResource BrandPrimarySoftBrush}" CornerRadius="10" Padding="16">
                        <TextBlock Text="Desktop workflow scaffolded. The functional implementation for this module will be connected to the existing POS business rules in the next batches." TextWrapping="Wrap" Foreground="{DynamicResource BrandPrimaryDarkBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,18">
                    <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource BrandPrimaryBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="B" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BusinessOS POS" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0" />
                    <TextBlock Text="Desktop" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="BusinessOS.af • WeSoft Technologies"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="10.5"
                           TextWrapping="Wrap"
                           Margin="8,12" />

                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigation}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{DynamicResource SidebarItemCornerRadius}"
                                                Padding="11,9">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SidebarItemSelectedBorderBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SidebarItemSelectedForegroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource TopBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNavigation.Title}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding SelectedNavigation.Subtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding UiLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  MinWidth="104"
                                  Margin="0,0,10,0"
                                  ToolTip="UI language" />
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  MinWidth="104"
                                  Margin="0,0,14,0"
                                  ToolTip="Appearance theme" />
                        <TextBlock Text="{Binding CurrentUserDisplay}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0" />
                        <Button Content="Sign out"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="82"
                                Click="OnSignOutClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource PageBackgroundBrush}" Padding="28">
                <ContentControl Content="{Binding SelectedNavigation.Key}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource ModuleTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="dashboard">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DashboardTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="pos">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PosTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="products">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ProductCatalogTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="inventory">
                                    <Setter Property="ContentTemplate" Value="{StaticResource InventoryTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="sales">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SalesTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="customers">
                                    <Setter Property="ContentTemplate" Value="{StaticResource CustomersTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="purchasing">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PurchasingTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="cash">
                                    <Setter Property="ContentTemplate" Value="{StaticResource CashTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="closing">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ClosingTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="expenses">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ExpensesTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="reports">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ReportsTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="terminals">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TerminalsTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="settings">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedNavigation.Key}" Value="users">
                                    <Setter Property="ContentTemplate" Value="{StaticResource UsersTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
