<Window x:Class="BusinessOS.POS.Desktop.Authentication.OwnerSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="First-run setup — BusinessOS POS"
        Width="560"
        Height="740"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="34">
        <Border Style="{StaticResource CardBorderStyle}" Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="16" Background="{DynamicResource BrandPrimaryBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="B" Foreground="White" FontSize="25" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Create the POS owner" FontSize="25" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,22,0,0" />
                    <TextBlock Text="This is required once on a fresh installation. The owner has full access and can create staff accounts later."
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="Full name" FontWeight="SemiBold" Margin="0,20,0,6" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center" />

                    <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center" />

                    <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />

                    <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <PasswordBox x:Name="PasswordInput" Height="40" Padding="10,0" VerticalContentAlignment="Center" />

                    <TextBlock Text="Confirm password" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <PasswordBox x:Name="ConfirmPasswordInput" Height="40" Padding="10,0" VerticalContentAlignment="Center" />

                    <Button Content="Create owner account"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44" Margin="0,22,0,0"
                            IsEnabled="{Binding IsNotBusy}"
                            Click="OnCreateClick" />

                    <Border Margin="0,14,0,0" Padding="12" CornerRadius="9" Background="{DynamicResource BrandPrimarySoftBrush}">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryDarkBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
