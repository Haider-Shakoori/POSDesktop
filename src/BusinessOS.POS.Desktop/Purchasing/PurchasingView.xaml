<UserControl x:Class="BusinessOS.POS.Desktop.Purchasing.PurchasingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="210" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="18,16,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Suppliers" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding Suppliers.Count, StringFormat={}{0} supplier(s)}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="88" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="58" />
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14,18,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Content="New Supplier" Command="{Binding NewSupplierCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="2" Content="Save Supplier" Command="{Binding SaveSupplierCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanManageSuppliers}" />
                        </Grid>

                        <TextBlock Text="Name" Style="{StaticResource MutedTextStyle}" Margin="0,12,0,3" />
                        <TextBox Text="{Binding SupplierName}" />
                        <TextBlock Text="Contact person" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,3" />
                        <TextBox Text="{Binding SupplierContactPerson}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Phone" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding SupplierPhone}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Alternate" Style="{StaticResource MutedTextStyle}" />
                                <TextBox Text="{Binding SupplierAlternatePhone}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Address" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,3" />
                        <TextBox Text="{Binding SupplierAddress}" AcceptsReturn="True" Height="52" />
                        <TextBlock Text="Opening payable (AFN)" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,3" />
                        <TextBox Text="{Binding SupplierOpeningBalance}" />
                        <TextBlock Text="Notes" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,3" />
                        <TextBox Text="{Binding SupplierNotes}" AcceptsReturn="True" Height="46" />
                        <CheckBox Content="Active supplier" IsChecked="{Binding SupplierIsActive}" Margin="0,10,0,0" />

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12" />
                        <TextBlock Text="Record supplier payment" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding SelectedSupplier.CurrentBalance, StringFormat=Current payable: AFN {0:N2}}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,4,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SupplierPaymentAmount}" ToolTip="Amount AFN" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding PaymentMethods}"
                                      SelectedItem="{Binding SelectedSupplierPaymentMethod}"
                                      DisplayMemberPath="Name" />
                        </Grid>
                        <TextBox Text="{Binding SupplierPaymentReference}" ToolTip="Reference"
                                 Margin="0,7,0,0" />
                        <TextBox Text="{Binding SupplierPaymentNotes}" ToolTip="Notes"
                                 Margin="0,7,0,0" />
                        <Button Content="Record Payment"
                                Command="{Binding RecordSupplierPaymentCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding CanPaySuppliers}"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <TabControl Grid.Column="2">
            <TabItem Header="Supplier Ledger">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="CURRENT PAYABLE" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding SelectedSupplier.CurrentBalance, StringFormat=AFN {0:N2}}"
                                           Style="{StaticResource StatValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="OPEN RECEIPTS" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding SupplierOpenReceipts.Count}" Style="{StaticResource StatValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="PAYMENTS" Style="{StaticResource StatLabelStyle}" />
                                <TextBlock Text="{Binding SupplierPayments.Count}" Style="{StaticResource StatValueStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding SupplierLedger}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding OccurredAt, StringFormat=g}" Width="140" />
                                <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="150" />
                                <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter, StringFormat=N2}" Width="95" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="140" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding SupplierOpenReceipts}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GRN" Binding="{Binding Number}" Width="145" />
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt, StringFormat=g}" Width="145" />
                                <DataGridTextColumn Header="Total" Binding="{Binding NetTotal, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedTotal, StringFormat=N2}" Width="90" />
                                <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat=N2}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Purchase Orders">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="145" />
                                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding NetTotal, StringFormat=N2}" Width="90" />
                                    <DataGridTextColumn Header="Order date" Binding="{Binding OrderDate, StringFormat=d}" Width="105" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="1" Margin="16,12,16,16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Content="Approve" Command="{Binding ApproveOrderCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanApproveOrders}" />
                                <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelOrderCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanApproveOrders}" />
                                <Button Grid.Column="4" Content="Receive PO" Command="{Binding PrepareReceiptFromOrderCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanReceive}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="New purchase order" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding SelectedSupplier.Name, StringFormat=Supplier: {0}, TargetNullValue=Select a supplier on the left}"
                                           Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <DatePicker SelectedDate="{Binding OrderDate}" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding ExpectedDate}" />
                                </Grid>
                                <TextBox Text="{Binding OrderSupplierReference}" ToolTip="Supplier reference"
                                         Margin="0,8,0,0" />

                                <Grid Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedOrderProduct}"
                                              DisplayMemberPath="Name" />
                                    <Button Grid.Column="2" Content="Add Item" Command="{Binding AddOrderLineCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>

                                <DataGrid ItemsSource="{Binding OrderLines}" AutoGenerateColumns="False"
                                          CanUserAddRows="False" MinHeight="170" MaxHeight="270">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Product" Binding="{Binding Product.Name}" Width="*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <DataGridTextColumn Header="Disc." Binding="{Binding LineDiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                        <DataGridTemplateColumn Width="48">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="×" Width="30" Height="26"
                                                            Command="{Binding DataContext.RemoveOrderLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OrderDraftTotal, StringFormat=Draft total: AFN {0:N2}}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding OrderDiscountAmount}" ToolTip="Order discount" />
                                </Grid>
                                <TextBox Text="{Binding OrderNotes}" ToolTip="Order notes" AcceptsReturn="True"
                                         Height="48" Margin="0,8,0,0" />
                                <Button Content="Create Purchase Order" Command="{Binding CreateOrderCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding CanCreateOrders}" Height="42" Margin="0,10,0,0" />

                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,12" />
                                <TextBlock Text="{Binding SelectedOrderDetail.Header.Number, TargetNullValue=Select an order}"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <DataGrid ItemsSource="{Binding SelectedOrderDetail.Items}" AutoGenerateColumns="False"
                                          IsReadOnly="True" MinHeight="130" MaxHeight="220" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*" />
                                        <DataGridTextColumn Header="Ordered" Binding="{Binding OrderedQuantity, StringFormat=N2}" Width="78" />
                                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedQuantity, StringFormat=N2}" Width="78" />
                                        <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingQuantity, StringFormat=N2}" Width="82" />
                                        <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="72" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Goods Receipts &amp; Returns">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.02*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}"
                                      AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GRN" Binding="{Binding Number}" Width="145" />
                                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding NetTotal, StringFormat=N2}" Width="85" />
                                    <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, StringFormat=N2}" Width="85" />
                                    <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt, StringFormat=g}" Width="135" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="1" Margin="16,12,16,16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button Content="New Direct Receipt" Command="{Binding NewDirectReceiptCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanDirectReceive}" />
                                <Button Grid.Column="2" Content="Load Selected PO" Command="{Binding PrepareReceiptFromOrderCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanReceive}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReceiptMode}" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding SelectedSupplier.Name, StringFormat=Supplier: {0}, TargetNullValue=Select supplier}"
                                               Style="{StaticResource MutedTextStyle}" Margin="0,4,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedReceiptProduct}"
                                                  DisplayMemberPath="Name" />
                                        <Button Grid.Column="2" Content="Add Product" Command="{Binding AddReceiptLineCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding ReceiptLines}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" MinHeight="160" MaxHeight="260" Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Product" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="65" />
                                            <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost}" Width="75" />
                                            <DataGridTextColumn Header="Disc." Binding="{Binding LineDiscountAmount}" Width="65" />
                                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="90" />
                                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiresAt, StringFormat=d}" Width="90" />
                                            <DataGridTemplateColumn Width="48">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="×" Width="30" Height="26"
                                                                Command="{Binding DataContext.RemoveReceiptLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SupplierInvoiceReference}" ToolTip="Supplier invoice reference" />
                                        <TextBox Grid.Column="2" Text="{Binding ReceiptDiscountAmount}" ToolTip="Receipt discount AFN" />
                                    </Grid>

                                    <TextBlock Text="Landed-cost expenses" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,4" />
                                    <DataGrid ItemsSource="{Binding ReceiptExpenses}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" MaxHeight="140">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="95" />
                                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="80" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                            <DataGridTemplateColumn Width="48">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="×" Width="30" Height="26"
                                                                Command="{Binding DataContext.RemoveExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="Add Expense" Command="{Binding AddExpenseCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,0,0" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ReceiptPaidAmount}" ToolTip="Paid now AFN" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding PaymentMethods}"
                                                  SelectedItem="{Binding SelectedReceiptPaymentMethod}"
                                                  DisplayMemberPath="Name" />
                                        <TextBox Grid.Column="4" Text="{Binding ReceiptPaymentReference}" ToolTip="Payment reference" />
                                    </Grid>
                                    <TextBox Text="{Binding ReceiptNotes}" ToolTip="Receipt notes" AcceptsReturn="True"
                                             Height="46" Margin="0,8,0,0" />
                                    <Button Content="Post Goods Receipt" Command="{Binding PostReceiptCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanReceive}"
                                            Height="42" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedReceiptDetail.Header.Number, TargetNullValue=Select a posted receipt}"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding SelectedReceiptDetail.Header.BalanceDue, StringFormat=Balance due: AFN {0:N2}}"
                                               Style="{StaticResource MutedTextStyle}" Margin="0,4,0,8" />
                                    <DataGrid ItemsSource="{Binding ReturnLines}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" MinHeight="140" MaxHeight="230">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Product" Binding="{Binding Line.Product}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Received" Binding="{Binding Line.Quantity, StringFormat=N2}" Width="76" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Returnable" Binding="{Binding Line.ReturnableQuantity, StringFormat=N2}" Width="82" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Return Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="82" />
                                            <DataGridTextColumn Header="Amount" Binding="{Binding EstimatedAmount, StringFormat=N2}" Width="82" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="145" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ReturnReason}" ToolTip="Purchase return reason" />
                                        <TextBlock Grid.Column="2" Text="{Binding ReturnDraftTotal, StringFormat=AFN {0:N2}}"
                                                   FontWeight="Bold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Button Content="Post Purchase Return" Command="{Binding PostReturnCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            IsEnabled="{Binding CanReturnPurchases}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.ColumnSpan="3"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,14,12">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}"
                       MaxWidth="560" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>